{
  "name": "mam-edge-reminder",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check background.js && node --check popup.js && node --check state.js && node --check reminder.js && node --check i18n.js",
    "test:ui": "node tests/browser.mjs",
    "release": "node scripts/release.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "store:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-store.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
